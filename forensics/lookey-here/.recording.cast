[31.810767, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      we had been guilty, but now we had a way to atone for it. We\r\n:\u001b[K"]
[31.82903, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      would accept our Life Mandate, and we would work for our\r\n:\u001b[K"]
[32.284761, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      brothers, gladly and willingly, and we would erase our sin\r\n:\u001b[K"]
[32.78183, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      against them, which they did not know, but we knew. So we were\r\n:\u001b[K"]
[32.81266, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      happy, and proud of ourselves and of our victory over ourselves.\r\n:\u001b[K"]
