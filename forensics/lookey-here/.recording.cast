[15.354082, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[21;1H\u001b[?1h\u001b=\r"]
[15.356031, "o", "      ANTHEM\r\n\r\n      by Ayn Rand\r\n\r\n\r\n        CONTENTS\r\n\r\n         PART ONE\r\n\r\n         PART TWO\r\n\r\n         PART THREE\r\n\r\n         PART FOUR\r\n\r\n         PART FIVE\r\n\r\n         PART SIX\r\n\r\n         PART SEVEN\r\n:\u001b[K"]
[17.339928, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[17.833867, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K         PART EIGHT\r\n:\u001b[K"]
[17.866451, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[17.897316, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K         PART NINE\r\n:\u001b[K"]
[17.931632, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[17.961809, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K         PART TEN\r\n:\u001b[K"]
[17.993154, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.023623, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K         PART ELEVEN\r\n:\u001b[K"]
[18.05701, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.08862, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K         PART TWELVE\r\n:\u001b[K"]
[18.119898, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.152022, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.185072, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.214317, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.273628, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      PART ONE\r\n:\u001b[K"]
[18.303595, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.320786, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[18.32143, "o", "      It is a sin to write this. It is a sin to think words no others\r\n:\u001b[K"]
[18.343632, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      think and to put them down upon a paper no others are to see. It\r\n:\u001b[K"]
[18.376836, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[18.377415, "o", "      is base and evil. It is as if we were speaking alone to no ears\r\n:\u001b[K"]
[18.40959, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      but our own. And we know well that there is no transgression\r\n:\u001b[K"]
[18.439044, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      blacker than to do or think alone. We have broken the laws. The\r\n:\u001b[K"]
[18.470479, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      laws say that men may not write unless the Council of Vocations\r\n:\u001b[K"]
[18.504309, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      bid them so. May we be forgiven!\r\n:\u001b[K"]
[18.534544, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.565555, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      But this is not the only sin upon us. We have committed a greater\r\n:\u001b[K"]
[18.598365, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      crime, and for this crime there is no name. What punishment\r\n:\u001b[K"]
[18.63106, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      awaits us if it be discovered we know not, for no such crime has\r\n:\u001b[K"]
[18.661956, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      come in the memory of men and there are no laws to provide for\r\n:\u001b[K"]
[18.694232, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      it.\r\n:\u001b[K"]
[18.727647, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[18.757087, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      It is dark here. The flame of the candle stands still in the air.\r\n:\u001b[K"]
[18.787929, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      Nothing moves in this tunnel save our hand on the paper. We are\r\n:\u001b[K"]
[18.822962, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      alone here under the earth. It is a fearful word, alone. The laws\r\n:\u001b[K"]
[18.867008, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      say that none among men may be alone, ever and at any time, for\r\n:\u001b[K"]
[18.907959, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      this is the great transgression and the root of all evil. But we\r\n:\u001b[K"]
[18.916366, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[18.916974, "o", "      have broken many laws. And now there is nothing here save our one\r\n:\u001b[K"]
[18.949446, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      body, and it is strange to see only two legs stretched on the\r\n:\u001b[K"]
[18.97976, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      ground, and on the wall before us the shadow of our one head.\r\n:\u001b[K"]
[19.012316, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[19.044648, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      The walls are cracked and water runs upon them in thin threads\r\n:\u001b[K"]
[19.078298, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      without sound, black and glistening as blood. We stole the candle\r\n:\u001b[K"]
[19.109386, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      from the larder of the Home of the Street Sweepers. We shall be\r\n:\u001b[K"]
[19.141447, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      sentenced to ten years in the Palace of Corrective Detention if\r\n:\u001b[K"]
[19.173424, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      it be discovered. But this matters not. It matters only that the\r\n:\u001b[K"]
[19.20325, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      light is precious and we should not waste it to write when we"]
[19.203799, "o", "\r\n:\u001b[K"]
[19.235337, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      need it for that work which is our crime. Nothing matters save\r\n:\u001b[K"]
[19.267583, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      the work, our secret, our evil, our precious work. Still, we must\r\n:\u001b[K"]
[19.300911, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      also write, for—may the Council have mercy upon us!—we wish to\r\n:\u001b[K"]
[19.333687, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      speak for once to no ears but our own.\r\n:\u001b[K"]
[19.998754, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[20.398084, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      Our name is Equality 7-2521, as it is written on the iron\r\n:\u001b[K"]
[20.894366, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      bracelet which all men wear on their left wrists with their names\r\n:\u001b[K"]
[20.925076, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      upon it. We are twenty-one years old. We are six feet tall, and\r\n:\u001b[K"]
[20.957254, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      this is a burden, for there are not many men who are six feet\r\n:\u001b[K"]
[20.9904, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      tall. Ever have the Teachers and the Leaders pointed to us and\r\n:\u001b[K"]
[21.020858, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      frowned and said:\r\n:\u001b[K"]
[21.065792, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[21.100022, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      “There is evil in your bones, Equality 7-2521, for your body has\r\n:\u001b[K"]
[21.117647, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      grown beyond the bodies of your brothers.” But we cannot change\r\n:\u001b[K"]
[21.147544, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      our bones nor our body.\r\n:\u001b[K"]
[21.180935, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[21.213809, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      We were born with a curse. It has always driven us to thoughts\r\n:\u001b[K"]
[21.245587, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      which are forbidden. It has always given us wishes which men may\r\n:\u001b[K"]
[21.277023, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      not wish. We know that we are evil, but there is no will in us\r\n:\u001b[K"]
[21.310624, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      and no power to resist it. This is our wonder and our secret\r\n:\u001b[K"]
[21.340984, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[21.341517, "o", "      fear, that we know and do not resist.\r\n:\u001b[K"]
[21.372222, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[21.404133, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      We strive to be like all our brother men, for all men must be\r\n:\u001b[K"]
[21.437245, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      alike. Over the portals of the Palace of the World Council, there\r\n:\u001b[K"]
[21.466394, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      are words cut in the marble, which we repeat to ourselves\r\n:\u001b[K"]
[21.497908, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      whenever we are tempted:\r\n:\u001b[K"]
[21.531356, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[21.563732, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K  “WE ARE ONE IN ALL AND ALL IN ONE.\r\n:\u001b[K"]
[21.596239, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K  THERE ARE NO MEN BUT ONLY THE GREAT _WE_,\r\n:\u001b[K"]
[21.627774, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K  ONE, INDIVISIBLE AND FOREVER.”\r\n:\u001b[K"]
[21.660081, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[21.692812, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      We repeat this to ourselves, but it helps us not.\r\n:\u001b[K"]
[21.721296, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[21.753915, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      These words were cut long ago. There is green mould in the\r\n:\u001b[K"]
[21.823312, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      grooves of the letters and yellow streaks on the marble, which\r\n:\u001b[K"]
[21.826028, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      come from more years than men could count. And these words are\r\n:\u001b[K"]
[21.863702, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      the truth, for they are written on the Palace of the World\r\n:\u001b[K"]
[21.882366, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      Council, and the World Council is the body of all truth. Thus has\r\n:\u001b[K"]
[21.914419, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      it been ever since the Great Rebirth, and farther back than that\r\n:\u001b[K"]
[21.945384, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      no memory can reach.\r\n:\u001b[K"]
[21.977996, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\r\n:\u001b[K"]
[22.010989, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K      But we must never speak of the times before the Great Rebirth,\r\n:\u001b[K"]
